# https://mqtt-api.nodewave.dev -> provisioning API on 127.0.0.1:8790.
# Cloudflare proxied. Installed to /etc/nginx/sites-available/mqtt-api.nodewave.dev;
# certbot --nginx adds the 443 lines (see PROVISIONING.md).

# 30 requests a minute per client IP; a wrong API key is also logged by the API
limit_req_zone $binary_remote_addr zone=mqtt_api:1m rate=30r/m;

server {
    listen 80;
    listen [::]:80;
    server_name mqtt-api.nodewave.dev;

    # Restores the visitor's real IP from Cloudflare's CF-Connecting-IP header.
    include /etc/nginx/cloudflare-realip.conf;

    client_max_body_size 1k;

    location ~ ^/(v1/|healthz$) {
        limit_req zone=mqtt_api burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8790;
        proxy_set_header Host      $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        return 404;
    }
}
