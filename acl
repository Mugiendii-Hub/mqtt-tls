# Mosquitto access rules (installed to /etc/mosquitto/acl by ./install.sh).
# Topic layout (new firmware): <device-id>/up/...    device -> server
#                              <device-id>/down/...  server -> device
# Any topic name can be added under up/ or down/ without changing this file.
# Old firmware still uses <device-id>/status|points|cmd|cfg until it is reflashed.
# A user with no rules here can do nothing.

# ---- Per-device logins (new firmware): username = device id = topic prefix.
# A device can only publish under its own up/ and read its own down/.
pattern write %u/up/#
pattern read  %u/down/#

# ---- Legacy shared device login. Every device in the field uses it until the
# firmware update (FIRMWARE.md). Old topics only; no $SYS, nothing else.
user admin
topic readwrite +/status
topic readwrite +/points
topic readwrite +/cmd
topic readwrite +/cfg

# ---- Server-side relays: read device data, send commands/config.
# Both layouts until the last old-firmware device is reflashed.
user relay-mqtt
topic read  +/up/#
topic write +/down/#
topic read  +/status
topic write +/cmd

user relay-flowhub
topic read  +/up/#
topic write +/down/#
topic read  +/status
topic read  +/points
topic write +/cmd
topic write +/cfg

# The flowhub relay run from a laptop (client id flowhub_relay_local)
user relay-desktop
topic read  +/up/#
topic write +/down/#
topic read  +/status
topic read  +/points
topic write +/cmd
topic write +/cfg

# ---- Monitoring (/root/monitoring mqtt-logger): read-only, everything
user monitoring
topic read #
topic read $SYS/#
